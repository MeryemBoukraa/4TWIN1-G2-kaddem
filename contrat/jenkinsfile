stage('Docker Compose Build & Run') {
    steps {
        script {
            // Remove existing images (if necessary)
            sh '''
                if docker images | grep -q "ablouu/contrat"; then
                    docker rmi ablouu/contrat:2.0.0 || true
                fi
            '''
            
            // Ensure Maven tests run before Docker build
            dir('contrat') {
                sh 'mvn verify test'
            }

            // Remove orphaned containers and prune unused images
            sh 'docker-compose down --remove-orphans'
            sh 'docker system prune -af'

            // Explicitly build images using docker-compose
            sh 'docker-compose build'

            // Run the containers in detached mode
            sh 'docker-compose up -d'
        }
    }
}

stage('Docker Push') {
    steps {
        withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
            sh 'echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin'
            
            sh 'docker push ablouu/contrat:1.0'
            sh 'docker push ablouu/apigateway:1.0'  
            sh 'docker push ablouu/eurika:1.0'

        }
    }
}


       stage('Docker Compose Up') {
            steps {
                sh 'docker compose up -d'
            }
        }
    }

    post {
        always {
            sh 'docker compose down'
        }
    }
}

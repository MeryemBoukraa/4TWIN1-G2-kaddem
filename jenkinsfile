pipeline {
    agent any

    tools {
        jdk 'JAVA_HOME'       // Assurez-vous que c'est le nom exact de votre JDK configuré dans Jenkins
        maven 'M2_HOME'       // Assurez-vous que c'est le nom exact de votre Maven configuré dans Jenkins
    }

    environment {
        DB_URL = 'jdbc:h2:file:./Database/Data/contrat;AUTO_SERVER=TRUE'
        DB_USER = 'louay'
        DB_PASSWORD = ''
        
        // Configuration Nexus
        NEXUS_URL = 'http://localhost:8081'  // Modifier selon votre URL Nexus
        NEXUS_RELEASES = "${NEXUS_URL}/repository/maven-releases/"
        NEXUS_SNAPSHOTS = "${NEXUS_URL}/repository/maven-snapshots/"
    }

    stages {
        stage('Checkout Git') {
            steps {
                git branch: 'Louayabidi-4Twin1-G2', 
                     url: 'https://github.com/MeryemBoukraa/4TWIN1-G2-kaddem.git'
            }
        }

        stage('Compile') {
            steps {
                sh 'mvn clean compile'
            }
        }

        stage('Tests') {
            steps {
                sh 'mvn test'  // Exécution des tests
            }
            post {
                always {
                    junit 'target/surefire-reports/**/*.xml'  // Archivage des résultats des tests
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {  // Configuration SonarQube dans Jenkins
                    sh 'mvn sonar:sonar -Dsonar.token=sqa_630d16e1d2841ea09db84166a80d5bc0c1b8ec3e'
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                // Solution 1: Utilisation directe avec credentials dans la commande
                withCredentials([usernamePassword(credentialsId: 'nexus-credentials', 
                                passwordVariable: 'admin', 
                                usernameVariable: 'admin']) {
                    
                    // Déploiement conditionnel pour SNAPSHOT/RELEASE
                    script {
                        if (env.BRANCH_NAME == 'Louayabidi-4Twin1-G2') {
                            sh """
                            mvn deploy:deploy-file \
                              -DrepositoryId=nexus-releases \
                              -Durl=${NEXUS_RELEASES} \
                              -DpomFile=pom.xml \
                              -Dfile=target/Contrat-0.0.1-SNAPSHOT.jar \
                              -DskipTests \
                              -DaltDeploymentRepository=nexus-releases::default::${NEXUS_RELEASES}
                            """
                        }
                    }
                }
                
                // Solution alternative 2: Si vous avez configuré settings.xml correctement
                // sh 'mvn deploy -Dmaven.test.skip=true'
            }
        }
    }

    post {
        failure {
            emailext body: 'Le build ${BUILD_NUMBER} a échoué. Voir: ${BUILD_URL}',
                    subject: 'Échec du build: ${JOB_NAME}',
                    to: 'votre-email@example.com'
        }
        success {
            echo 'Build et déploiement réussis!'
        }
    }
}
         stage('MVN Nexus') {
            steps {
                sh 'mvn deploy -Dmaven.test.skip=true'
            }
        }

        

      
    }
}
